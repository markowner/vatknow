# ──────────────────────────────────────────────
# VatKnow 环境变量
# 复制为 .env 后填写，docker compose up 即可启动
# ──────────────────────────────────────────────

# JWT 签名密钥（必填，务必替换为随机字符串，切勿使用默认值上线）
# 生成方式：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-32-chars-string

# OpenAI 兼容接口（留空则智能问答与向量检索不可用，文档管理和关键词检索仍正常）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 数据库（docker compose 内自动配置，本地开发按需修改）
DATABASE_URL=postgresql+psycopg://vatknow:vatknow@localhost:5432/vatknow

# 跨域来源，逗号分隔
CORS_ORIGINS=http://localhost:3000

# 是否开放 Swagger API 文档（/docs、/redoc）
# 本地开发可设为 true，生产环境务必设为 false
ENABLE_DOCS=false
